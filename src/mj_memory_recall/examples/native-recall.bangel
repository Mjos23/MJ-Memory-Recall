program mj_memory_recall
effects pure
import mj.recall as recall
let memories: Vector[recall.Episode] = [recall.Episode(id = "memory-a", namespace = "robotics.lab", entity = "robot", relation = "inspection", context = "bench", observed_at = 10, available_at = 11, pattern = [0.9, 0.9, 0.9, 0.9, 0.9, 0.9, 0.9, 0.9, 0.9], aligned = [recall.Aligned(observation = recall.Event(actor = "sensor", step = 0, position = recall.Position.Known(point = recall.Point(x = 100.0, y = 150.0)), command = Result.Ok("derive")), remembered = recall.Event(actor = "sensor", step = 0, position = recall.Position.Known(point = recall.Point(x = 100.0, y = 150.0)), command = Result.Ok("derive")), has_curve = false, curve = recall.Curve(start = recall.Point(x = 0.0, y = 0.0), control = recall.Point(x = 0.0, y = 0.0), finish = recall.Point(x = 0.0, y = 0.0), command = "measure")), recall.Aligned(observation = recall.Event(actor = "sensor", step = 1, position = recall.Position.Known(point = recall.Point(x = 160.0, y = 170.0)), command = Result.Ok("derive")), remembered = recall.Event(actor = "sensor", step = 1, position = recall.Position.Known(point = recall.Point(x = 160.0, y = 170.0)), command = Result.Ok("derive")), has_curve = false, curve = recall.Curve(start = recall.Point(x = 0.0, y = 0.0), control = recall.Point(x = 0.0, y = 0.0), finish = recall.Point(x = 0.0, y = 0.0), command = "measure")), recall.Aligned(observation = recall.Event(actor = "sensor", step = 2, position = recall.Position.Known(point = recall.Point(x = 220.0, y = 190.0)), command = Result.Ok("derive")), remembered = recall.Event(actor = "sensor", step = 2, position = recall.Position.Known(point = recall.Point(x = 220.0, y = 190.0)), command = Result.Ok("derive")), has_curve = false, curve = recall.Curve(start = recall.Point(x = 0.0, y = 0.0), control = recall.Point(x = 0.0, y = 0.0), finish = recall.Point(x = 0.0, y = 0.0), command = "measure"))]), recall.Episode(id = "memory-b", namespace = "robotics.lab", entity = "robot", relation = "inspection", context = "bench", observed_at = 10, available_at = 11, pattern = [0.9, 0.9, 0.9, 0.9, 0.9, 0.9, 0.9, 0.9, 0.9], aligned = [recall.Aligned(observation = recall.Event(actor = "sensor", step = 0, position = recall.Position.Known(point = recall.Point(x = 100.0, y = 150.0)), command = Result.Ok("derive")), remembered = recall.Event(actor = "sensor", step = 0, position = recall.Position.Known(point = recall.Point(x = 400.0, y = 150.0)), command = Result.Ok("derive")), has_curve = false, curve = recall.Curve(start = recall.Point(x = 0.0, y = 0.0), control = recall.Point(x = 0.0, y = 0.0), finish = recall.Point(x = 0.0, y = 0.0), command = "measure")), recall.Aligned(observation = recall.Event(actor = "sensor", step = 1, position = recall.Position.Known(point = recall.Point(x = 160.0, y = 170.0)), command = Result.Ok("derive")), remembered = recall.Event(actor = "sensor", step = 1, position = recall.Position.Known(point = recall.Point(x = 460.0, y = 170.0)), command = Result.Ok("derive")), has_curve = false, curve = recall.Curve(start = recall.Point(x = 0.0, y = 0.0), control = recall.Point(x = 0.0, y = 0.0), finish = recall.Point(x = 0.0, y = 0.0), command = "measure")), recall.Aligned(observation = recall.Event(actor = "sensor", step = 2, position = recall.Position.Known(point = recall.Point(x = 220.0, y = 190.0)), command = Result.Ok("derive")), remembered = recall.Event(actor = "sensor", step = 2, position = recall.Position.Known(point = recall.Point(x = 520.0, y = 190.0)), command = Result.Ok("derive")), has_curve = false, curve = recall.Curve(start = recall.Point(x = 0.0, y = 0.0), control = recall.Point(x = 0.0, y = 0.0), finish = recall.Point(x = 0.0, y = 0.0), command = "measure"))])]
let cue: Vector[recall.Feature; 9] = [recall.Feature.Known(value = 0.9), recall.Feature.Known(value = 0.9), recall.Feature.Known(value = 0.9), recall.Feature.Known(value = 0.9), recall.Feature.Known(value = 0.9), recall.Feature.Known(value = 0.9), recall.Feature.Known(value = 0.9), recall.Feature.Known(value = 0.9), recall.Feature.Known(value = 0.9)]
let frame = recall.Frame(x_min = 0.0, y_min = 0.0, width = 800.0, height = 600.0)
let history: Vector[recall.Transition] = [recall.Transition(previous = "derive", following = "derive"), recall.Transition(previous = "derive", following = "derive"), recall.Transition(previous = "derive", following = "derive"), recall.Transition(previous = "derive", following = "derive")]
let attempt = recall.retrieve(memories, cue, frame, "robotics.lab", 100, Result.Ok("robot"), Result.Ok("inspection"), Result.Ok("bench"))
match attempt
  case Result.Ok(result)
    emit retrieval = result
emit request_sha256 = "7dd0f8cb028c202d455da65d64550b44d450985d3053ef901bf7aed149a72e54"
emit review_status = recall.review_status(result.matched, false, "HOLD")
  case Result.Err(error)
    require false else RECALL_NATIVE_INPUT
end
emit original_cue = cue
emit profile = "MJ-Memory-Recall/0.1.0"
emit forecast = recall.forecast(history, "measure")
